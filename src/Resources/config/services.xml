<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Einstellungen, API-Client, Datenhaltung -->
        <service id="Nova\GoCardless\Service\Settings">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Nova\GoCardless\Api\GoCardlessClient">
            <argument type="service" id="logger"/>
            <argument type="service" id="http_client" on-invalid="null"/>
        </service>
        <service id="Nova\GoCardless\Service\TransactionStore">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Nova\GoCardless\Service\TransactionStateUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <argument type="service" id="logger"/>
        </service>
        <service id="Nova\GoCardless\Service\OrderNotes">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="notification.repository"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Zahlungsart -->
        <service id="Nova\GoCardless\Payment\GoCardlessSepaHandler">
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Nova\GoCardless\Api\GoCardlessClient"/>
            <argument type="service" id="Nova\GoCardless\Service\Settings"/>
            <argument type="service" id="Nova\GoCardless\Service\TransactionStore"/>
            <argument type="service" id="Nova\GoCardless\Service\TransactionStateUpdater"/>
            <argument type="service" id="logger"/>
            <tag name="shopware.payment.method"/>
        </service>

        <!-- Webhook -->
        <service id="Nova\GoCardless\Webhook\WebhookProcessor">
            <argument type="service" id="Nova\GoCardless\Service\TransactionStore"/>
            <argument type="service" id="Nova\GoCardless\Service\TransactionStateUpdater"/>
            <argument type="service" id="Nova\GoCardless\Service\OrderNotes"/>
            <argument type="service" id="Nova\GoCardless\Service\Settings"/>
            <argument type="service" id="Nova\GoCardless\Api\GoCardlessClient"/>
            <argument type="service" id="logger"/>
        </service>
        <service id="Nova\GoCardless\Controller\WebhookController" public="true">
            <argument type="service" id="Nova\GoCardless\Service\Settings"/>
            <argument type="service" id="Nova\GoCardless\Webhook\WebhookProcessor"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Konsole -->
        <service id="Nova\GoCardless\Command\TestCommand">
            <argument type="service" id="Nova\GoCardless\Service\Settings"/>
            <argument type="service" id="Nova\GoCardless\Api\GoCardlessClient"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
